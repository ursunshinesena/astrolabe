# Deployment (testnet only — never commit a mainnet key)
PRIVATE_KEY_DEPLOYER=

# Etherscan (for contract verification)
ETHERSCAN_API_KEY=

# App
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development
