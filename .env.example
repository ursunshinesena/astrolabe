# Gemini (Google AI Studio)
GEMINI_API_KEY=

# Circle — get from https://console.circle.com
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Developer-controlled wallets (created by the live runner / M1 setup)
CIRCLE_WALLET_ID_ETH_SEPOLIA=
CIRCLE_WALLET_ADDR_ETH_SEPOLIA=
CIRCLE_WALLET_ID_BASE_SEPOLIA=
CIRCLE_WALLET_ADDR_BASE_SEPOLIA=
CIRCLE_WALLET_ID_ARC_TESTNET=
CIRCLE_WALLET_ADDR_ARC_TESTNET=

# RPC endpoints (testnet) — Alchemy or Infura recommended
ETH_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARB_SEPOLIA_RPC_URL=
